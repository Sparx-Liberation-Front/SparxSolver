{
  "manifest_version": 3,
  "name": "Sparx Solver",
  "version": "1.0.0",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "sidePanel"
  ],

  "host_permissions": [
    "http://localhost/*"
  ],

  "action": {
    "default_title": "Open Sparx Solver",
    "default_icon": {
      "400": "logo.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "icons": {
    "400": "logo.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://maths.sparx-learning.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}